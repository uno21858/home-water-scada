menu "Casa (home-water-scada)"

    menu "Qué está instalado"
        # P1 y P2, el nivel y el LDR se detectan solos al conectarlos
        # (core/detect.h); aquí solo se dan por instalados desde el arranque.
        # La bomba R no se detecta: su GPIO44 es el RX de la consola de la mesa.

        config HMI_HAS_MIXER
            bool "Bomba R de mezcla (GPIO44 y el INA219)"
            default n

        config HMI_HAS_PRESSURE
            bool "Sensores de presión P1 y P2 (A0 y A1 del ADS1115)"
            default n

        config HMI_HAS_LEVEL
            bool "Sensor de nivel 4-20 mA (A2 del ADS1115)"
            default n

        config HMI_HAS_LDR
            bool "LDR para el brillo (A3 del ADS1115)"
            default n
    endmenu

    menu "Red y servidor"
        config HMI_METRICS_URL
            string "URL de VictoriaMetrics para los datos"
            default ""
            help
                El /write de VictoriaMetrics en el NAS, por ejemplo
                http://192.168.1.68:8428/write. Vacío: los datos se quedan en
                la cola ("Por enviar").

        config HMI_OTA_URL
            string "URL del firmware para la OTA"
            default ""
            help
                Dónde la placa busca el .bin nuevo, por ejemplo
                http://192.168.1.68:8070/hmi.bin (el NAS) o la IP de la laptop.
                Solo instala uno firmado con
                la misma llave. Vacío: sin OTA.

        config HMI_OTA_CHECK_MINUTES
            int "Cada cuántos minutos revisa si hay firmware nuevo"
            range 1 1440
            default 1
            help
                Sin nadie sirviendo, la revisada es un intento de conexión que
                falla: no cuesta nada. Con 1, servir-ota.sh no espera.
    endmenu

    menu "Bomba R (INA219)"
        # Los umbrales salen de la prueba 9b (bomba en una cubeta); estos son
        # para arrancar: ~1.6 A sumergida (la ZYW680, 19 W a 12 V) y fusible
        # de 2 A. Nivel bajo y atorada necesitan 500 ms seguidos, después de
        # 500 ms de ventana ciega al prenderla (core/mixer_watch.h). Atorada
        # era 1.90 A con una lectura suelta por segundo y la apagaba recién
        # prendida (26 oct 2026; lo más probable, el rizo de las escobillas).
        # Ahora 2.50, 1.5 veces lo normal.

        config HMI_MIXER_MIN_VOLTS_X10
            int "Abajo de este voltaje es sin 12 V (décimas de V)"
            default 90

        config HMI_MIXER_DRY_AMPS_X100
            int "Abajo de esta corriente es nivel bajo (centésimas de A)"
            default 100

        config HMI_MIXER_STUCK_AMPS_X100
            int "Arriba de esta corriente es atorada (centésimas de A)"
            default 250

        config HMI_INA219_SHUNT_MOHM
            int "Resistencia shunt del módulo INA219 (mΩ)"
            default 100
    endmenu

    config HMI_LCD_PCLK_MHZ
        int "Reloj de píxel de la pantalla (MHz)"
        range 10 40
        default 30
        help
            Cuántas veces por segundo se refresca: MHz / (1386 x 661), así que
            24 da ~26 por segundo y 30 da ~33. El demo de Waveshare usa 24 y se
            nota el parpadeo; 30 se probó en la 7B sin rayas (oct 2026). Cada
            MHz pide 2 MB/s más a la PSRAM: si la imagen se recorre o salen
            rayas, ya no alcanza (bajarlo, o subir la PSRAM a 120 MHz).

endmenu
